# ==========================================
# MedTrail Environment Configuration
# ==========================================

# Neo4j Database Configuration
# Cloud AuraDB or local Neo4j (bolt://localhost:7687)
NEO4J_URI=neo4j+s://<your-aura-instance>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<your-neo4j-password>
NEO4J_DATABASE=neo4j

# Application Settings
APP_NAME=MedTrail
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0

# LLM / Reasoning Layer (Optional for AI generation)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# Groq is used only by the backend to turn graph-retrieved papers into prose.
# Never expose this value to the frontend or commit your real .env file.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
